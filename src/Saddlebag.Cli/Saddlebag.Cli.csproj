<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>saddlebag</AssemblyName>
    <Version>0.5.0</Version>
    <RootNamespace>Saddlebag.Cli</RootNamespace>
    <!-- Publish self-contained for win-x64 to get one exe to share (see README). -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Saddlebag.Core\Saddlebag.Core.csproj" />
  </ItemGroup>

</Project>
