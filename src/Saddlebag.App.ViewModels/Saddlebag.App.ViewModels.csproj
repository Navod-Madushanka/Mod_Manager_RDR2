<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything the GUI does, without WPF: cross-platform, so it's tested on any OS. Saddlebag.App only adds views. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Saddlebag.App.ViewModels</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Saddlebag.Core\Saddlebag.Core.csproj" />
  </ItemGroup>

</Project>
