<UserControl x:Class="Saddlebag.App.Views.WatchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="Dev watch" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Hint}" Text="Watches your linked build folders (Mods → Link build folder) and deploys each build once it's finished. Waits while the game is open."/>
      <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
        <Button Command="{Binding ToggleCommand}">
          <Button.Style>
            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
              <Setter Property="Content" Value="Start watching"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding IsWatching}" Value="True"><Setter Property="Content" Value="Stop watching"/></DataTrigger>
              </Style.Triggers>
            </Style>
          </Button.Style>
        </Button>
        <TextBlock Text="Quiet period (ms):" VerticalAlignment="Center" Margin="8,0,4,0"/>
        <TextBox Text="{Binding QuietMs}" Width="70" IsEnabled="{Binding IsWatching, Converter={StaticResource InverseBool}}"/>
      </StackPanel>
      <ItemsControl ItemsSource="{Binding Targets}" Margin="0,0,0,8">
        <ItemsControl.ItemTemplate>
          <DataTemplate><TextBlock Text="{Binding StringFormat=Watching {0}}" Foreground="{StaticResource Muted}"/></DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
    <ListBox ItemsSource="{Binding Events}" FontFamily="Consolas" FontSize="12"/>
  </DockPanel>
</UserControl>
