<UserControl x:Class="Saddlebag.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Border MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28" Background="{StaticResource Panel}"
          BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6">
    <StackPanel>
      <TextBlock Text="Set up Saddlebag" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,16"
                 Text="Mods live in Saddlebag's own folder and are linked into the game. Keep that folder on the same drive as the game so links cost no extra disk."/>
      <TextBlock Text="Game folder (the one with RDR2.exe)" FontWeight="SemiBold"/>
      <DockPanel Margin="0,4,0,12">
        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding PickGameCommand}" Margin="8,0,0,0"/>
        <TextBox Text="{Binding GameDir, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
      </DockPanel>
      <TextBlock Text="Saddlebag folder (library, backups, state)" FontWeight="SemiBold"/>
      <DockPanel Margin="0,4,0,16">
        <Button DockPanel.Dock="Right" Content="Browse…" Command="{Binding PickHomeCommand}" Margin="8,0,0,0"/>
        <TextBox Text="{Binding HomeDir, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
      </DockPanel>
      <StackPanel Orientation="Horizontal">
        <Button Content="Set up" Style="{StaticResource PrimaryButton}" Command="{Binding InitCommand}"/>
      </StackPanel>
      <TextBlock Text="{Binding Result}" Style="{StaticResource Hint}" Margin="0,12,0,0"/>
    </StackPanel>
  </Border>
</UserControl>
