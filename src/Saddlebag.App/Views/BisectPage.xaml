<UserControl x:Class="Saddlebag.App.Views.BisectPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12">
      <TextBlock Text="Crash bisect" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Hint}" Text="Finds the mod that crashes the game: each launch tests half the suspects, so 32 mods take about 6 launches. It runs in a temporary profile; yours is never edited."/>

      <!-- Before starting: choose what stays on -->
      <StackPanel Visibility="{Binding IsActive, Converter={StaticResource InverseBoolToVis}}">
        <TextBlock Text="Kept on in every launch" Style="{StaticResource H2}"/>
        <TextBlock Style="{StaticResource Hint}" Text="Mods that ship Script Hook, LML or the .NET hook are kept on, because the rest can't run without them. Tick others that something needs (an asset pack); untick a hook to suspect it."/>
        <ItemsControl ItemsSource="{Binding Choices}" Margin="0,6,0,10">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <CheckBox IsChecked="{Binding Keep}" Margin="0,2">
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{Binding Name}"/>
                  <TextBlock Text="  (hook)" Foreground="{StaticResource Muted}" Visibility="{Binding IsHook, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
              </CheckBox>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button Content="Start bisect" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" HorizontalAlignment="Left"/>
      </StackPanel>

      <!-- Running -->
      <StackPanel Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
        <TextBlock Text="{Binding StepText}" FontSize="15" FontWeight="SemiBold" Margin="0,10,0,4" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding ResultText}" Style="{StaticResource Hint}" Visibility="{Binding ResultText, Converter={StaticResource NullToVis}}"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,10" Visibility="{Binding IsDone, Converter={StaticResource InverseBoolToVis}}">
          <Button Content="It crashed" Style="{StaticResource PrimaryButton}" Command="{Binding CrashedCommand}"/>
          <Button Content="It ran fine" Command="{Binding RanFineCommand}"/>
          <Button Content="Undo last answer" Command="{Binding UndoCommand}"/>
        </StackPanel>
        <Border Style="{StaticResource Banner}" Background="#FFEBE9" BorderBrush="#FF8182" Visibility="{Binding Culprit, Converter={StaticResource NullToVis}}">
          <TextBlock FontSize="15"><Run Text="Culprit: "/><Run Text="{Binding Culprit, Mode=OneWay}" FontWeight="Bold"/></TextBlock>
        </Border>
        <Grid Margin="0,6,0,0">
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
          <StackPanel Grid.Column="0">
            <TextBlock Text="Testing this launch" Style="{StaticResource H2}"/>
            <ItemsControl ItemsSource="{Binding Testing}"/>
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="Kept on" Style="{StaticResource H2}"/>
            <ItemsControl ItemsSource="{Binding Kept}"/>
          </StackPanel>
          <StackPanel Grid.Column="2" Visibility="{Binding CrashSet.Count, Converter={StaticResource CountToVis}}">
            <TextBlock Text="Crash needs some of these together" Style="{StaticResource H2}"/>
            <ItemsControl ItemsSource="{Binding CrashSet}"/>
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
          <Button Content="End and disable culprit" Command="{Binding ResetDisableCulpritCommand}" Visibility="{Binding Culprit, Converter={StaticResource NullToVis}}"/>
          <Button Content="End bisect (restore my profile)" Command="{Binding ResetCommand}"/>
        </StackPanel>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
