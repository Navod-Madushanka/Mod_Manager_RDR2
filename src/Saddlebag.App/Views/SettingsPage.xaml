<UserControl x:Class="Saddlebag.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="12">
      <TextBlock Text="Baseline" Style="{StaticResource H1}"/>
      <TextBlock Style="{StaticResource Hint}" Text="A snapshot of your clean install: every file's size, time and hash. Capture it with mods moved out and files verified in your launcher, and again after each game update."/>
      <TextBlock Text="{Binding BaselineText}" FontWeight="SemiBold" Margin="0,8,0,8"/>
      <StackPanel Orientation="Horizontal">
        <Button Content="Capture baseline…" Style="{StaticResource PrimaryButton}" Command="{Binding CaptureBaselineCommand}"/>
        <Button Content="Capture anyway (mod files present)…" Command="{Binding ForceCaptureBaselineCommand}"/>
      </StackPanel>
      <ProgressBar Height="8" Margin="0,8,0,0" Maximum="1" Value="{Binding Progress}" Visibility="{Binding Capturing, Converter={StaticResource BoolToVis}}"/>

      <TextBlock Text="Online exceptions" Style="{StaticResource H1}" Margin="0,24,0,6"/>
      <TextBlock Style="{StaticResource Hint}" Text="Allowed extras show amber in Online mode (they're still not vanilla). Expected changes are vanilla files the launcher rewrites, such as a DLSS DLL."/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,8">
        <Button Content="Allow a file…" Command="{Binding AddAllowedCommand}"/>
        <Button Content="Expect a change…" Command="{Binding AddExpectedCommand}"/>
      </StackPanel>
      <DataGrid ItemsSource="{Binding Rules}" MaxHeight="240">
        <DataGrid.Columns>
          <DataGridTextColumn Header="Path" Binding="{Binding Path}" Width="*"/>
          <DataGridTextColumn Header="Rule" Binding="{Binding Rule}"/>
          <DataGridTemplateColumn Header="">
            <DataGridTemplateColumn.CellTemplate>
              <DataTemplate>
                <Button Content="Remove" Style="{StaticResource RowButton}"
                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
              </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
          </DataGridTemplateColumn>
        </DataGrid.Columns>
      </DataGrid>

      <TextBlock Text="Routing rules" Style="{StaticResource H1}" Margin="0,24,0,6"/>
      <TextBlock Style="{StaticResource Hint}" Text="Loader and hook names, file extensions and each rule's explanation are data. If a mod uses a name Saddlebag doesn't know, export the rules, edit rules.json, and restart."/>
      <TextBlock Text="{Binding RulesText}" Margin="0,8,0,8"/>
      <Button Content="Export rules for editing…" Command="{Binding ExportRulesCommand}" HorizontalAlignment="Left"/>

      <TextBlock Text="Folders" Style="{StaticResource H1}" Margin="0,24,0,6"/>
      <TextBlock Text="{Binding Paths}" FontFamily="Consolas"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
